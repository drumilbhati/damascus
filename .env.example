# ==============================================================================
# DAMASCUS — Environment Configuration Template
# Copy this file to .env before starting: `cp .env.example .env`
# ==============================================================================

# Control Plane HTTP Server Port
PORT=8080

# PostgreSQL Relational Persistence
POSTGRES_USER=damascus
POSTGRES_PASSWORD=damascus
POSTGRES_DB=damascus
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://damascus:damascus@postgres:5432/damascus?sslmode=disable

# Observability Infrastructure Endpoints
PROMETHEUS_URL=http://prometheus:9090
JAEGER_URL=http://jaeger:16686

# Apache Kafka Event Streaming Backbone (internal Docker listener)
KAFKA_BROKERS=kafka:29092

# Target Microservice Mesh (OpenTelemetry Astronomy Shop)
TARGET_BASE_URL=http://frontend:8080

# Direct test targets, keyed by the exact service.name in Jaeger/Prometheus.
# The gateway bridges HTTP JSON to OTel Demo gRPC and HTTP APIs on damascus-net.
# Read operations use GET defaults. Mapped state-changing operations are configured to use POST
# with demo-safe sample JSON in the experiment details; review before running them.
SERVICE_TARGET_URLS='{
  "frontend": "http://frontend:8080/",
  "cartservice": "http://otel-demo-http-gateway:8090/v1/CartService/GetCart?request=%7B%22userId%22%3A%22damascus-load-test%22%7D",
  "recommendationservice": "http://otel-demo-http-gateway:8090/v1/RecommendationService/ListRecommendations",
  "productcatalogservice": "http://otel-demo-http-gateway:8090/v1/ProductCatalogService/ListProducts",
  "shippingservice": "http://otel-demo-http-gateway:8090/v1/ShippingService/GetQuote?request=%7B%22address%22%3A%7B%22streetAddress%22%3A%221600%20Amphitheatre%20Parkway%22%2C%22city%22%3A%22Mountain%20View%22%2C%22state%22%3A%22CA%22%2C%22country%22%3A%22US%22%2C%22zipCode%22%3A%2294043%22%7D%2C%22items%22%3A%5B%7B%22productId%22%3A%22OLJCESPC7Z%22%2C%22quantity%22%3A1%7D%5D%7D",
  "currencyservice": "http://otel-demo-http-gateway:8090/v1/CurrencyService/Convert?request=%7B%22from%22%3A%7B%22currencyCode%22%3A%22USD%22%2C%22units%22%3A1%7D%2C%22toCode%22%3A%22EUR%22%7D",
  "paymentservice": "http://otel-demo-http-gateway:8090/v1/PaymentService/Charge",
  "checkoutservice": "http://otel-demo-http-gateway:8090/v1/CheckoutService/PlaceOrder",
  "adservice": "http://otel-demo-http-gateway:8090/v1/AdService/GetAds",
  "quoteservice": "http://otel-demo-http-gateway:8090/v1/quoteservice/getquote?request=%7B%22numberOfItems%22%3A1%7D",
  "emailservice": "http://otel-demo-http-gateway:8090/v1/emailservice/send_order_confirmation"
}'

# Maximum concurrent requests issued by the stress generator
STRESS_MAX_IN_FLIGHT=2048

# Web Dashboard Frontend
WEB_PORT=3000
