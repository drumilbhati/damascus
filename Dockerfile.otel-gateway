FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/otel-http-gateway ./cmd/otel-http-gateway

FROM alpine:3.20
RUN apk --no-cache add ca-certificates \
    && addgroup -g 10001 damascus \
    && adduser -D -u 10001 -G damascus damascus
COPY --from=builder /bin/otel-http-gateway /bin/otel-http-gateway
USER damascus:damascus
EXPOSE 8090
ENTRYPOINT ["/bin/otel-http-gateway"]
